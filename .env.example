# 로컬에서는 웹 설정 화면의 `저장하고 연결 시작`으로 macOS Keychain 또는
# Windows Credential Manager에 저장합니다. Linux/컨테이너에서는 환경변수나
# 아래 master key 기반 암호화 저장소를 사용합니다. 어떤 비밀값에도
# NEXT_PUBLIC_ 접두사를 붙이지 마세요.

# KIWOOM_PAPER_APP_KEY=
# KIWOOM_PAPER_APP_SECRET=
# KIWOOM_PAPER_ACCOUNT_ID=
# KIWOOM_LIVE_APP_KEY=
# KIWOOM_LIVE_APP_SECRET=
# KIWOOM_LIVE_ACCOUNT_ID=
# 공식 문서가 ka10095 요청당 최대 종목 수를 명시하지 않아 기본값은 1입니다.
# 모의계좌에서 ACK를 확인한 뒤에만 늘리세요 (1~200).
# KIWOOM_QUOTE_BATCH_SIZE=1

# KIS_PAPER_APP_KEY=
# KIS_PAPER_APP_SECRET=
# KIS_PAPER_ACCOUNT_ID=
# KIS_PAPER_ACCOUNT_PRODUCT_CODE=01
# KIS_PAPER_HTS_ID=
# KIS_LIVE_APP_KEY=
# KIS_LIVE_APP_SECRET=
# KIS_LIVE_ACCOUNT_ID=
# KIS_LIVE_ACCOUNT_PRODUCT_CODE=01
# KIS_LIVE_HTS_ID=
# KIS_USE_HASHKEY=false

# 한국투자 선물·옵션 계좌는 현물 계좌와 별도 scope로 저장됩니다.
# 웹에서는 현물 API 키를 서버 안에서 재사용할 수 있습니다. 서버 환경변수로
# 직접 관리할 때는 아래 키·계좌를 모두 설정하고 상품코드는 반드시 03으로 둡니다.
# KIS_DERIVATIVES_PAPER_APP_KEY=
# KIS_DERIVATIVES_PAPER_APP_SECRET=
# KIS_DERIVATIVES_PAPER_ACCOUNT_ID=
# KIS_DERIVATIVES_PAPER_ACCOUNT_PRODUCT_CODE=03
# KIS_DERIVATIVES_PAPER_HTS_ID=
# KIS_DERIVATIVES_LIVE_APP_KEY=
# KIS_DERIVATIVES_LIVE_APP_SECRET=
# KIS_DERIVATIVES_LIVE_ACCOUNT_ID=
# KIS_DERIVATIVES_LIVE_ACCOUNT_PRODUCT_CODE=03
# KIS_DERIVATIVES_LIVE_HTS_ID=

# ENGINE_URL=http://127.0.0.1:3210
# ENGINE_HOST=127.0.0.1
# ENGINE_PORT=3210
# WEB_HOST=127.0.0.1
# WEB_PORT=3100
# WEB_ORIGIN=http://127.0.0.1:3100
# KSTOCK_DATA_DIR=/absolute/path/to/private/data
# KSTOCK_DB_PATH=/absolute/path/to/private/data/kstock.sqlite3
# KSTOCK_ADMIN_TOKEN=minimum-32-character-random-secret
# KSTOCK_MASTER_KEY=minimum-32-character-encryption-secret
# KSTOCK_REQUIRE_WEB_AUTH=true
# KSTOCK_WEB_USERNAME=admin
# KSTOCK_WEB_PASSWORD=minimum-16-character-console-password
# KSTOCK_MARKET_HOLIDAYS=2026-01-01,2026-02-16
